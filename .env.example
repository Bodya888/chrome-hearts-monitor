# Copy this file to .env and fill it in.

# --- iCloud Mail (default) ---
# SMTP_PASSWORD is an app-specific password, NOT your Apple ID password:
# appleid.apple.com -> Sign-In and Security -> App-Specific Passwords
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_USER=you@icloud.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Gmail alternative ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=<16-char app password from myaccount.google.com/apppasswords>

# Sender must be the same account as SMTP_USER for iCloud/Gmail
# EMAIL_FROM defaults to SMTP_USER
EMAIL_FROM=
# One or more recipients, comma-separated
EMAIL_TO=

# 1 = also notify when a sold-out item comes back in stock, 0 = new items only
NOTIFY_RESTOCK=1

# How often to check, in seconds (used by install.sh). 120 = every 2 minutes.
# One check takes ~20 seconds; don't go much below 60 to avoid getting blocked.
CHECK_INTERVAL=120

# Extra paths to watch besides the built-in hidden sections, comma-separated,
# e.g. a product link you saw on Instagram: hoodie/some-hoodie/123456BLKXXX001.html
WATCH_PATHS=
